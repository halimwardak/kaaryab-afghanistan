NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://kaaryab:change-me@localhost:5432/kaaryab?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
# Optional comma-separated exact additional frontend origins. HTTPS only in production.
# Add only reviewed production aliases or preview domains, never *.vercel.app.
TRUSTED_ORIGINS=
TRUST_PROXY=0
# Optional SMTP. Reset requests return a generic response without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Set temporarily when running admin:create, never in NEXT_PUBLIC variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
