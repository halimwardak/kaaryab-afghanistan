generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW
  ACCEPTED
  REJECTED
}

model User {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  locale String @default("en") @db.VarChar(5)
  email String @unique @db.VarChar(254)
  passwordHash String
  role Role @default(USER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  resets PasswordReset[]
  saved SavedOpportunity[]
  applications Application[]
  opportunities Opportunity[]
}

model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id String @id @default(uuid())
  name String @unique @db.VarChar(80)
  nameFa String? @db.VarChar(80)
  namePs String? @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  opportunities Opportunity[]
}

model Opportunity {
  id String @id @default(uuid())
  title String @db.VarChar(200)
  organization String @db.VarChar(200)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type String @db.VarChar(20)
  location String @db.VarChar(200)
  deadline DateTime @db.Date
  applyLink String
  description String
  requirements String[]
  tags String[]
  translations OpportunityTranslation[]
  status OpportunityStatus @default(DRAFT)
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  saved SavedOpportunity[]
  applications Application[]
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([deadline])
  @@index([type])
}

model OpportunityTranslation {
  id String @id @default(uuid())
  opportunityId String
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  locale String @db.VarChar(5)
  title String @db.VarChar(200)
  organization String @db.VarChar(200)
  location String @db.VarChar(200)
  description String
  requirements String[]
  tags String[]
  @@unique([opportunityId, locale])
  @@index([locale, title])
}

model SavedOpportunity {
  userId String
  opportunityId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, opportunityId])
  @@index([opportunityId])
}

model Application {
  id String @id @default(uuid())
  userId String
  opportunityId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  coverLetter String
  resumeUrl String?
  status ApplicationStatus @default(SUBMITTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, opportunityId])
  @@index([status, createdAt])
  @@index([opportunityId])
}

model ContactMessage {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  email String @db.VarChar(254)
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([read, createdAt])
}
